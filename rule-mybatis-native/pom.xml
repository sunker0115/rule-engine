<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sstlfsj.rule</groupId>
        <artifactId>rule-engine</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>rule-mybatis-native</artifactId>

    <!--
      vendored 自 mybatis-plus PR #7017（Apache-2.0，package com.baomidou.mybatisplus.aot）：
      为 MyBatis-Plus 提供 GraalVM native-image 支持（反射/JDK 代理/SerializedLambda/日志实现）。
      上游 3.0 分支未发版，3.5.16 不含此模块，故整体引入；待上游发版后可切回官方依赖删除本模块。
      所有依赖 provided：消费方（rule-app）已自带 MyBatis-Plus，graal SDK 仅 native 构建期需要。
    -->
    <dependencies>
        <!-- MapperFactoryBean / mybatis core / mybatis-plus（编译期 API，运行期由消费方提供） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @ConditionalOnClass / AOT 处理 API（spring-context-aot、spring-beans-aot 经 starter 传递） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- GraalVM Feature / RuntimeReflection / RuntimeSerialization：仅 native-image 构建期需要 -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>25.0.3</version>
            <scope>provided</scope>
        </dependency>
        <!-- JUnit5 + AssertJ：验证 RuntimeHints 注册（RuntimeHintsPredicates 在 spring-core，经 provided 传递） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
