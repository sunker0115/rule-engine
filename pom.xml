<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.sstlfsj.rule</groupId>
    <artifactId>rule-engine</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>rule-kernel</module>
        <module>rule-expression-cel</module>
        <module>rule-expression-cel-spring-boot-starter</module>
        <module>rule-expression-aviator</module>
        <module>rule-expression-aviator-spring-boot-starter</module>
        <module>rule-expression-qlexpress</module>
        <module>rule-expression-qlexpress-spring-boot-starter</module>
        <module>rule-expression-jsonlogic</module>
        <module>rule-expression-jsonlogic-spring-boot-starter</module>
        <module>rule-expression-jexl</module>
        <module>rule-expression-jexl-spring-boot-starter</module>
        <module>rule-expression-groovy</module>
        <module>rule-expression-groovy-spring-boot-starter</module>
        <module>rule-config-svc</module>
        <module>rule-eval-svc</module>
        <module>rule-job-svc</module>
        <module>rule-job-xxl</module>
        <module>rule-audit-svc</module>
        <module>rule-observability</module>
        <module>rule-api</module>
        <module>rule-app</module>
        <module>rule-sdk</module>
        <module>rule-sdk-spring-boot-starter</module>
        <module>rule-benchmark</module>
        <module>rule-samples</module>
    </modules>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <archunit.version>1.4.2</archunit.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <guava.version>33.2.1-jre</guava.version>
        <lombok.version>1.18.44</lombok.version>
        <mysql-connector-j.version>9.0.0</mysql-connector-j.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <!-- OTel instrumentation（logback-appender 等），与 opentelemetry.version=1.55.0 配套 -->
        <opentelemetry-instrumentation.version>2.16.0-alpha</opentelemetry-instrumentation.version>
        <!-- springdoc 3.x 系列适配 Spring Boot 4（3.0.3 以 spring-boot 4.0.5 为 parent） -->
        <springdoc.version>3.0.3</springdoc.version>
        <!-- xxl-job-core 3.4.0：稳定版（2026-04-05），自身基于 Spring Boot 4.0.5 构建，无 javax 引用 -->
        <xxl-job.version>3.4.0</xxl-job.version>
        <!-- EXPRESSION_SCRIPT 各表达式引擎库版本（parent BOM 未管理，集中钉死于此） -->
        <cel.version>0.13.0</cel.version>
        <aviator.version>5.4.3</aviator.version>
        <qlexpress.version>3.3.4</qlexpress.version>
        <json-logic.version>1.1.0</json-logic.version>
        <commons-jexl.version>3.6.2</commons-jexl.version>
        <groovy.version>5.0.6</groovy.version>
        <!-- craftercms 维护分支(kohsuke 原版停更于 2018 的 1.19),面向现代 Groovy,包名仍 org.kohsuke.groovy.sandbox -->
        <groovy-sandbox.version>4.3.2</groovy-sandbox.version>
        <!-- RE2J:线性时间正则(防 ReDoS),MATCHES 算子底层引擎 -->
        <re2j.version>1.8</re2j.version>
        <!-- protobuf-java:覆盖 Spring Boot 4 BOM 的 4.26.1,dev.cel 0.13.0 gencode 需运行时 ≥ 4.33 -->
        <protobuf.version>4.35.1</protobuf.version>
    </properties>

    <build>
        <plugins>
            <!-- 注解处理器：Lombok 必须在 MapStruct 之前，否则 MapStruct 看不到 Lombok 生成的方法 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <goals><goal>testCompile</goal></goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                    <version>${lombok.version}</version>
                                </path>
                                <path>
                                    <groupId>org.mapstruct</groupId>
                                    <artifactId>mapstruct-processor</artifactId>
                                    <version>${mapstruct.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- CI Friendly Versions: 将 ${revision} 替换为实际值后再 install/deploy -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Modulith BOM -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus (Spring Boot 3/4 compatible artifact) -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MyBatis-Plus JSQLParser：3.5.9+ 将 PaginationInnerInterceptor 拆分到此模块 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- MySQL Connector -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>

            <!-- Guava (only for rule-kernel: murmur3 hash for ROLLOUT gate) -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- RE2J (only for rule-kernel: MATCHES 算子线性时间正则，防 ReDoS) -->
            <dependency>
                <groupId>com.google.re2j</groupId>
                <artifactId>re2j</artifactId>
                <version>${re2j.version}</version>
            </dependency>

            <!-- protobuf-java：dev.cel 0.13.0 gencode 为 4.33.x，需运行时 ≥ 4.33；
                 覆盖 Spring Boot 4 BOM 的 4.26.1（唯一消费方是 dev.cel，否则脚本编译期类初始化报版本不兼容） -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Lombok 1.18.44+：支持 Java 25，可与 record 共存；不加在 record 类上 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <optional>true</optional>
            </dependency>

            <!-- MapStruct：运行时接口 jar（processor 在 annotationProcessorPaths 中，不需要加 scope=provided） -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ArchUnit -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- OTel Logback appender（spring-boot-starter-opentelemetry 未传递此依赖，需显式声明） -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
            </dependency>

            <!-- springdoc OpenAPI：内嵌 Swagger UI，仅 rule-api 暴露 REST 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- xxl-job 执行器核心（adapter 模块按需引入；admin 端独立部署不在此） -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- EXPRESSION_SCRIPT 表达式引擎库（各 rule-expression-* 模块引用，版本集中于此） -->
            <dependency>
                <groupId>dev.cel</groupId>
                <artifactId>cel</artifactId>
                <version>${cel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.aviator</groupId>
                <artifactId>aviator</artifactId>
                <version>${aviator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>QLExpress</artifactId>
                <version>${qlexpress.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jamsesso</groupId>
                <artifactId>json-logic-java</artifactId>
                <version>${json-logic.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-jexl3</artifactId>
                <version>${commons-jexl.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.craftercms</groupId>
                <artifactId>groovy-sandbox</artifactId>
                <version>${groovy-sandbox.version}</version>
            </dependency>

            <!-- 内部模块版本管理 -->
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-cel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-cel-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-aviator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-aviator-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-qlexpress</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-qlexpress-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-jsonlogic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-jsonlogic-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-jexl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-jexl-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-groovy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-expression-groovy-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-config-svc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-eval-svc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-job-svc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-job-xxl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-audit-svc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sstlfsj.rule</groupId>
                <artifactId>rule-sdk-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
