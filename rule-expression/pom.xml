<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sstlfsj.rule</groupId>
        <artifactId>rule-engine</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>rule-expression</artifactId>
    <packaging>pom</packaging>

    <!-- EXPRESSION_SCRIPT 表达式引擎聚合：每种引擎成对(纯引擎 + -spring-boot-starter)。
         仅聚合，不管理依赖版本——第三方引擎库与内部模块 version 集中在根 pom，
         因 dependencyManagement 不横向继承，且 config/eval-svc 等非本聚合模块需引用 cel starter。 -->
    <modules>
        <module>rule-expression-cel</module>
        <module>rule-expression-cel-spring-boot-starter</module>
        <module>rule-expression-aviator</module>
        <module>rule-expression-aviator-spring-boot-starter</module>
        <module>rule-expression-qlexpress</module>
        <module>rule-expression-qlexpress-spring-boot-starter</module>
        <module>rule-expression-jsonlogic</module>
        <module>rule-expression-jsonlogic-spring-boot-starter</module>
        <module>rule-expression-jexl</module>
        <module>rule-expression-jexl-spring-boot-starter</module>
        <module>rule-expression-groovy</module>
        <module>rule-expression-groovy-spring-boot-starter</module>
    </modules>
</project>
