{
  "tenantId": "demo-tenant",
  "code": "risk.transfer",
  "name": "风控-转账拦截",
  "dominantMode": "PULL",
  "decisionStrategy": "HIGHEST_PRIORITY",
  "eventTypes": ["transfer.initiated"],
  "subjectType": "USER",
  "payloadSchema": {
    "amount":       { "type": "number",  "required": true  },
    "currency":     { "type": "string",  "required": true  },
    "dest_account": { "type": "string",  "required": true  }
  },
  "defaultParams": {
    "timezone": "Asia/Shanghai"
  },
  "metricBindings": [
    { "metricCode": "user.account.age.days"           },
    { "metricCode": "user.kyc.level"                  },
    { "metricCode": "user.transfer.count.7d"          },
    { "metricCode": "user.transfer.dest.trust.score"  }
  ],
  "actionBindings": [],
  "decisions": [
    { "code": "REJECT", "name": "拒绝",     "priority": 1,   "actions": [] },
    { "code": "REVIEW", "name": "人工审核", "priority": 2,   "actions": [] },
    { "code": "PASS",   "name": "放行",     "priority": 100, "actions": [] }
  ]
}
