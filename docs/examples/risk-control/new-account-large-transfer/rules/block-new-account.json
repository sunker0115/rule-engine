{
  "tenantId": "demo-tenant",
  "sceneCode": "risk.transfer",
  "code": "block-new-account-large-transfer",
  "name": "新账户大额转账拦截",
  "triggerEventTypes": ["transfer.initiated"],
  "preGates": [
    {
      "type": "ROLLOUT",
      "params": { "percentage": 100 }
    },
    {
      "type": "RATE_LIMIT",
      "params": {
        "window": "1d",
        "maxHits": 1,
        "scope": "subject"
      }
    },
    {
      "type": "WHITELIST",
      "params": {
        "listKey": "risk.transfer.whitelist"
      }
    }
  ],
  "conditionAst": {
    "type": "AndNode",
    "displayLabel": "全部满足",
    "children": [
      {
        "type": "OrNode",
        "displayLabel": "账户风险（满足其一）",
        "children": [
          {
            "type": "ConditionNode",
            "displayLabel": "开户不足 30 天",
            "conditionType": "METRIC_COMPARE",
            "params": {
              "metricCode": "user.account.age.days",
              "operator": "LT",
              "value": 30
            }
          },
          {
            "type": "ConditionNode",
            "displayLabel": "KYC 未完成",
            "conditionType": "METRIC_COMPARE",
            "params": {
              "metricCode": "user.kyc.level",
              "operator": "LT",
              "value": 2
            }
          }
        ]
      },
      {
        "type": "AndNode",
        "displayLabel": "大额 CNY 交易",
        "children": [
          {
            "type": "ConditionNode",
            "displayLabel": "金额 ≥ 5 万",
            "conditionType": "PAYLOAD_COMPARE",
            "params": {
              "field": "amount",
              "operator": "GTE",
              "value": 50000
            }
          },
          {
            "type": "ConditionNode",
            "displayLabel": "币种为 CNY",
            "conditionType": "PAYLOAD_COMPARE",
            "params": {
              "field": "currency",
              "operator": "EQ",
              "value": "CNY"
            }
          }
        ]
      },
      {
        "type": "ConditionNode",
        "displayLabel": "近 7 天转账次数 < 3",
        "conditionType": "METRIC_COMPARE",
        "params": {
          "metricCode": "user.transfer.count.7d",
          "operator": "LT",
          "value": 3
        }
      },
      {
        "type": "NotNode",
        "displayLabel": "收款方信任分不高",
        "child": {
          "type": "ConditionNode",
          "displayLabel": "收款方信任分 ≥ 80",
          "conditionType": "METRIC_COMPARE",
          "params": {
            "metricCode": "user.transfer.dest.trust.score",
            "operator": "GTE",
            "value": 80
          }
        }
      }
    ]
  },
  "decisionBindings": [
    { "decisionCode": "REJECT" }
  ],
  "metricDependencies": [
    "user.account.age.days",
    "user.kyc.level",
    "user.transfer.count.7d",
    "user.transfer.dest.trust.score"
  ]
}
