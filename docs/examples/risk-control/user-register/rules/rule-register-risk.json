{
  "tenantId": "demo-tenant",
  "sceneCode": "risk.register",
  "code": "rule-register-risk",
  "name": "注册风险拦截",
  "triggerEventTypes": ["user.registered"],
  "preGates": [
    { "type": "ROLLOUT", "params": { "percentage": 100 } }
  ],
  "conditionAst": {
    "type": "OrNode",
    "displayLabel": "注册风险命中其一",
    "children": [
      {
        "type": "AndNode",
        "displayLabel": "高风险设备 + 低信誉 IP",
        "children": [
          {
            "type": "ConditionNode",
            "conditionType": "metric.threshold",
            "displayLabel": "设备信任分 < 40",
            "metricCode": "user.device.trust.score",
            "params": { "operator": "LT", "value": 40 }
          },
          {
            "type": "ConditionNode",
            "conditionType": "metric.threshold",
            "displayLabel": "IP 信誉分 < 30",
            "metricCode": "user.ip.reputation.score",
            "params": { "operator": "LT", "value": 30 }
          }
        ]
      },
      {
        "type": "ConditionNode",
        "conditionType": "metric.threshold",
        "displayLabel": "命中黑名单",
        "metricCode": "user.blacklist.hit",
        "params": { "operator": "EQ", "value": true }
      },
      {
        "type": "AndNode",
        "displayLabel": "未完成 KYC + 未知渠道",
        "children": [
          {
            "type": "ConditionNode",
            "conditionType": "metric.threshold",
            "displayLabel": "KYC 未完成",
            "metricCode": "user.kyc.level",
            "params": { "operator": "EQ", "value": 0 }
          },
          {
            "type": "ConditionNode",
            "conditionType": "event.payload.equals",
            "displayLabel": "渠道未知",
            "params": { "field": "channel", "operator": "EQ", "value": "unknown" }
          }
        ]
      }
    ]
  },
  "decisionBindings": [
    { "decisionCode": "REJECT" }
  ],
  "metricDependencies": [
    "user.device.trust.score",
    "user.ip.reputation.score",
    "user.kyc.level",
    "user.blacklist.hit"
  ]
}
