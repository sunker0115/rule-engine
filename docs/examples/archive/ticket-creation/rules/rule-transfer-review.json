{
  "tenantId": "demo-tenant",
  "sceneCode": "risk.transfer",
  "code": "rule-transfer-review",
  "name": "转账人工审核触发",
  "description": "命中条件时输出 REVIEW Decision，异步派发 ticket.create action 建人工审核单。与 block-new-account.json 的区别：该规则绑定 REVIEW（priority=2），用于账户风险较低但仍需人工复核的场景。",
  "triggerEventTypes": ["transfer.initiated"],
  "preGates": [
    { "type": "ROLLOUT",    "params": { "percentage": 100 } },
    { "type": "WHITELIST",  "params": { "listKey": "risk.transfer.whitelist" } }
  ],
  "conditionAst": {
    "type": "AndNode",
    "displayLabel": "需人工审核的转账",
    "children": [
      {
        "type": "OrNode",
        "displayLabel": "账户风险（满足其一）",
        "children": [
          {
            "type": "ConditionNode",
            "conditionType": "metric.threshold",
            "displayLabel": "开户 30–90 天",
            "metricCode": "user.account.age.days",
            "params": { "operator": "BETWEEN", "min": 30, "max": 90 }
          },
          {
            "type": "ConditionNode",
            "conditionType": "metric.threshold",
            "displayLabel": "KYC 初级",
            "metricCode": "user.kyc.level",
            "params": { "operator": "EQ", "value": 1 }
          }
        ]
      },
      {
        "type": "AndNode",
        "displayLabel": "中等金额 CNY",
        "children": [
          {
            "type": "ConditionNode",
            "conditionType": "event.payload.compare",
            "displayLabel": "金额 ≥ 2 万",
            "params": { "field": "amount", "operator": "GTE", "value": 20000 }
          },
          {
            "type": "ConditionNode",
            "conditionType": "event.payload.equals",
            "displayLabel": "币种为 CNY",
            "params": { "field": "currency", "operator": "EQ", "value": "CNY" }
          }
        ]
      },
      {
        "type": "ConditionNode",
        "conditionType": "metric.threshold",
        "displayLabel": "收款方信任分 40–79（中等风险）",
        "metricCode": "user.transfer.dest.trust.score",
        "params": { "operator": "BETWEEN", "min": 40, "max": 79 }
      }
    ]
  },
  "decisionBindings": [
    { "decisionCode": "REVIEW" }
  ],
  "metricDependencies": [
    { "metricCode": "user.account.age.days", "metricVersion": 1 },
    { "metricCode": "user.kyc.level", "metricVersion": 1 },
    { "metricCode": "user.transfer.dest.trust.score", "metricVersion": 1 }
  ]
}
