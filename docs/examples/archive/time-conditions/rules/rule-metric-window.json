{
  "tenantId": "demo-tenant",
  "sceneCode": "ops.promotion",
  "code": "rule-metric-window",
  "name": "近 7 天活跃用户规则",
  "description": "时间窗口逻辑封装在 Metric SQL 内（NOW() - INTERVAL 7 DAY），条件层只判断聚合结果值是否 >= 3，不感知时间。适合历史行为聚合场景。",
  "triggerEventTypes": ["user.action.login"],
  "preGates": [
    { "type": "ROLLOUT", "params": { "percentage": 100 } }
  ],
  "conditionAst": {
    "type": "ConditionNode",
    "conditionType": "metric.threshold",
    "displayLabel": "近 7 天登录 ≥ 3 次",
    "metricCode": "user.login.count.7d",
    "params": {
      "operator": "GTE",
      "value": 3
    }
  },
  "decisionBindings": [
    { "decisionCode": "REWARD" }
  ],
  "metricDependencies": [
    { "metricCode": "user.login.count.7d", "metricVersion": 1 }
  ]
}
